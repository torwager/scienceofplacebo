"id": "doi:10.1126/science.170.3960.864",
"title": "Pharmacological differentiation of allergic and classically conditioned asthma in the guinea pig.",
"authors": [
"Justesen DR",
"Braun EW",
"Garrison RG",
"Pendleton RB"
],
"journal": "Science (New York, N.Y.)",
"journal_abbrev": "Science",
