{
  // Science of Placebo community API: GitHub sign-in, starred lists, community picks.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "scienceofplacebo-community",
  "main": "src/index.js",
  "compatibility_date": "2026-09-03",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true, "head_sampling_rate": 1 },
  "kv_namespaces": [
    { "binding": "STORE", "id": "540ab2b6b6174644a88a259087210f7c" }
  ],
  "vars": {
    "SITE_ORIGIN": "https://scienceofplacebo.org",
    "GITHUB_CLIENT_ID": "Ov23liwWsOvRPUdUfjrg"
  },
  // Custom domain (Cloudflare DNS zone scienceofplacebo.org). Remove this block to use the workers.dev URL instead.
  "routes": [ { "pattern": "community.scienceofplacebo.org", "custom_domain": true } ]
}
